# Trava simples da API (ver adr/0009-trava-simples-antes-de-autenticacao-real.md).
# OBRIGATÓRIO desde 2026-09-26: sem API_AUTH_TOKEN a API recusa tudo (503).
# Todo request precisa mandar "Authorization: Bearer <o mesmo valor>".
# Gere um valor longo e aleatório, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Só pra desenvolvimento local: 1 = roda aberta quando API_AUTH_TOKEN está vazio.
# Nunca use com a API exposta na rede (--host 0.0.0.0).
API_PERMITIR_SEM_TOKEN=

# Origens liberadas pro app na web (CORS), separadas por vírgula.
# Vazio = só o Expo web local (http://localhost:8081, http://127.0.0.1:8081).
API_CORS_ORIGENS=

# Várias pessoas, cada uma com o próprio banco (ver adr/0010). Quando
# preenchido, substitui o API_AUTH_TOKEN: cada código abre só o banco da
# sua pessoa. Formato nome:codigo, separados por vírgula (código com 16+
# caracteres, gere com o mesmo comando acima). Crie cada banco antes com
# python core/criar_banco_usuario.py <nome> --pasta <API_PASTA_BANCOS>
API_USUARIOS=
# Pasta dos bancos por pessoa. Vazio = core/bancos/ (no servidor, aponte para o volume persistente).
API_PASTA_BANCOS=
