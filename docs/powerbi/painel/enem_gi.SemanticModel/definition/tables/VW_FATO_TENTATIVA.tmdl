table VW_FATO_TENTATIVA
	lineageTag: fa1c8fd2-f531-41f4-9462-dc1d2a6420db

	measure Tentativas = COUNTROWS(VW_FATO_TENTATIVA)
		formatString: 0
		lineageTag: 996849fd-512c-46a5-9bc2-2e14940f89cf

	measure '% Acerto' = DIVIDE(SUM(VW_FATO_TENTATIVA[ACERTOU]), [Tentativas])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: eee7e166-73de-4c73-b5b3-e4b57b5fd38d

	/// Texto já formatado (1.067): o cartão novo do Power BI abrevia número para "1 Mil" e não guarda o ajuste de unidade.
	measure 'Total de tentativas' = FORMAT([Tentativas], "#,0")
		lineageTag: e1ae14dc-cc24-4cc4-9972-5d5a4cbc4207

	measure 'Em branco' = SUM(VW_FATO_TENTATIVA[EM_BRANCO])
		formatString: 0
		lineageTag: 6507e433-4553-4a2e-83bd-17f12d639155

	/// Esconde matéria com menos de 10 tentativas: % de 1 ou 2 respostas não diz nada (mesma ideia de MIN_AMOSTRA_CONFIAVEL no app).
	measure 'Tentativas (amostra 10+)' = IF([Tentativas] >= 10, [Tentativas])
		formatString: 0
		lineageTag: 7a391ed0-3169-4129-8c32-a50137c34a9d

	/// % de acerto só onde há 10+ tentativas; em branco nas demais, o que tira a linha da tabela.
	measure '% Acerto (amostra 10+)' = IF([Tentativas] >= 10, [% Acerto])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 24938827-9971-4009-acd3-520c2cc15041

